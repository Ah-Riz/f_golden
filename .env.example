# =============================================================================
# Gold Rush AI — environment template
# Copy to .env  →  cp .env.example .env
# Fill secrets in .env only. Never commit .env. Never put keys in MQL5.
# Full guide: docs/ENV.md
# =============================================================================

# --- Local bridge (you invent these; EA must match) ---------------------------
# WHERE: invent any secret string yourself (password generator / openssl).
# USE:   same value in MT5 EA input InpBridgeToken
# EXAMPLE: openssl rand -hex 16
GRAI_BRIDGE_TOKEN=

# WHERE: you choose; default 8765 is fine if free
# USE:   bridge listen port; EA URL uses this port
GRAI_BRIDGE_PORT=8765

# WHERE: local path relative to where you start the bridge (or absolute)
# USE:   JSONL audit log file for request/response (no secrets logged as keys)
GRAI_JSONL=grai_bridge.jsonl

# --- Z.AI / GLM provider (get from Z.AI website) ------------------------------
# WHERE: https://z.ai  → register/login → API Keys page
# DOCS:  https://docs.z.ai/api-reference/introduction
#        https://docs.z.ai/guides/develop/http/introduction
# PASTE: the key they show you (Bearer token). Do not share or commit.
ZAI_API_KEY=

# WHERE: fixed by Z.AI for OpenAI-compatible chat (general API)
# DOCS:  https://docs.z.ai/guides/develop/openai/python
# NOTE:  bridge calls {GRAI_BASE_URL}/chat/completions
#        Profile switch — swap the active line with the commented one:
#        Coding Plan (subscription credits, $0; off-peak = 50% rate):
#          https://api.z.ai/api/coding/paas/v4
#        Pay-as-you-go general (glm-5.3-flash ≈ $3-6 per 12k-bar backtest,
#        needs account credit; free models here: glm-4.7-flash, glm-4.5-flash):
#          https://api.z.ai/api/paas/v4
GRAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# GRAI_BASE_URL=https://api.z.ai/api/paas/v4

# WHERE: you pick a label for logs (default zai)
GRAI_PROVIDER=zai

# WHERE: model id from Z.AI model list / your plan
# DOCS:  https://docs.z.ai  (Models)
# glm-5.3-flash works on BOTH endpoints above (verified on coding plan).
GRAI_MODEL=glm-5.3-flash

# WHERE: provider feature flag — try json_object first; if verify fails use none
GRAI_RESPONSE_FORMAT=json_object

# WHERE: you version your prompt text (bump when you change prompts)
GRAI_PROMPT_VERSION=grai.prompt.v0.2

# Optional alias if a host expects OPENAI_API_KEY instead of ZAI_API_KEY:
# OPENAI_API_KEY=
